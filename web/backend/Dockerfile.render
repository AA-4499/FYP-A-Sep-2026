FROM python:3.11-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY web/backend/requirements.txt /app/web/backend/requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu "torch>=2.0" \
    && pip install --no-cache-dir -r /app/web/backend/requirements.txt

COPY . /app

ENV PYTHONUNBUFFERED=1
ENV FLASK_HOST=0.0.0.0
ENV OMP_NUM_THREADS=1

CMD ["gunicorn", "--chdir", "web/backend", "-w", "1", "--threads", "2", "--timeout", "180", "-b", "0.0.0.0:10000", "app:app"]

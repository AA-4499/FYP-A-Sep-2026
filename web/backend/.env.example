# Backend-only environment variables. Do not use the browser publishable key as the server key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_server_only_key

# Option A: private Supabase storage, no Render persistent disk required.
# Apply docs/supabase_model_storage.sql first, then initialize from the Admin panel.
# T2DM_STORAGE_BACKEND=supabase
# T2DM_STORAGE_BUCKET=model-artifacts
# T2DM_CACHE_DIR=/tmp/t2dm-model-cache
# See docs/supabase-model-storage.md. Keep one API worker.

# Option B (default disk provider): attach a real persistent disk before retraining.
# T2DM_PERSISTENT_MOUNT=/var/data
# T2DM_MODEL_DIR=/var/data/t2dm-model
# Initialize once from the repository root: python -m web.backend.services.model_store --initialize
# T2DM_CHECKPOINT_PATH is an optional migration seed, not the active-release pointer.
# See docs/model-storage-runbook.md; retain all existing KG/Supabase settings.

# Shared Neo4j Aura instance. Configure values on Render's backend (or a local ignored .env).
CLINICAL_KG_NEO4J_URI=neo4j+s://e72f4649.databases.neo4j.io
CLINICAL_KG_NEO4J_USER=e72f4649
CLINICAL_KG_NEO4J_PASSWORD=replace-with-a-new-rotated-aura-password
CLINICAL_KG_NEO4J_DATABASE=neo4j

# Graph analysis default is local and graph-grounded. OpenAI is optional.
KG_AI_PROVIDER=rules
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# API security / frontend origin. Match your deployed frontend origin.
ALLOWED_ORIGINS=http://localhost:5173,https://your-vercel-domain.vercel.app

# Doctor invite landing page. Add this exact URL to Supabase Auth Redirect URLs.
# Use https://your-vercel-domain.vercel.app/?auth=invite in production.
DOCTOR_INVITE_REDIRECT_URL=http://localhost:5173/?auth=invite

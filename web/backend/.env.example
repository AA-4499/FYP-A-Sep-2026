# Shared Neo4j Aura instance. Configure values on Render's backend (or a local ignored .env).
CLINICAL_KG_NEO4J_URI=neo4j+s://e72f4649.databases.neo4j.io
CLINICAL_KG_NEO4J_USER=e72f4649
CLINICAL_KG_NEO4J_PASSWORD=replace-with-a-new-rotated-aura-password
CLINICAL_KG_NEO4J_DATABASE=e72f4649

# Graph analysis default is local and graph-grounded. OpenAI is optional.
KG_AI_PROVIDER=rules
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# API security / frontend origin. Match your deployed frontend origin.
ALLOWED_ORIGINS=http://localhost:5173,https://your-vercel-domain.vercel.app

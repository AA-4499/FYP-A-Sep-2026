# Local-only Neo4j credentials used by Docker Compose.
NEO4J_USER=neo4j
NEO4J_PASSWORD=training3graph

# Use bolt://neo4j:7687 inside Docker. A host-run Flask process defaults to
# bolt://127.0.0.1:7687 when NEO4J_URI is not set.
NEO4J_URI=bolt://neo4j:7687

# Supabase Database Configuration (patient_summary & patient_detail)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-vercel-domain.vercel.app

# Python forecasting API (server-only values)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-server-only-service-key
# Optional: local HS256 verification; leave unset to verify tokens through Supabase Auth.
# SUPABASE_JWT_SECRET=your-project-legacy-HS256-JWT-secret
# Optional override for the clinician-facing Aura graph. Keep these values local; do not commit secrets.
# When omitted, the doctor KG reader falls back to NEO4J_URI / NEO4J_USER / NEO4J_PASSWORD below.
DOCTOR_KG_NEO4J_URI=neo4j+s://<your-aura-instance>.databases.neo4j.io
DOCTOR_KG_NEO4J_USER=neo4j
DOCTOR_KG_NEO4J_PASSWORD=replace-with-your-local-aura-password
DOCTOR_KG_NEO4J_DATABASE=neo4j

# Frontend API origin, configured in web/frontend/.env.local or Vercel
VITE_API_BASE_URL=http://localhost:5000

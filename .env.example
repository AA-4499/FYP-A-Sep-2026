# Local-only Neo4j credentials used by Docker Compose.
NEO4J_USER=neo4j
NEO4J_PASSWORD=training3graph

# Use bolt://neo4j:7687 inside Docker. A host-run Flask process defaults to
# bolt://127.0.0.1:7687 when NEO4J_URI is not set.
NEO4J_URI=bolt://neo4j:7687

# Shared Neo4j Aura instance for clinical concepts and patient condition graphs (backend only).
CLINICAL_KG_NEO4J_URI=neo4j+s://e72f4649.databases.neo4j.io
CLINICAL_KG_NEO4J_USER=e72f4649
CLINICAL_KG_NEO4J_PASSWORD=replace-with-a-new-rotated-aura-password
CLINICAL_KG_NEO4J_DATABASE=neo4j

# Graph analysis runs locally by default; an OpenAI provider is optional.
KG_AI_PROVIDER=rules
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Supabase Database Configuration (patient_summary & patient_detail)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-vercel-domain.vercel.app

# Python forecasting API (server-only values)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_server_only_key
# Optional: local HS256 verification; leave unset to verify tokens through Supabase Auth.
# SUPABASE_JWT_SECRET=your-project-legacy-HS256-JWT-secret
# Frontend API origin, configured in web/frontend/.env.local or Vercel
VITE_API_BASE_URL=http://localhost:5000

# Neo4j Aura clinical concept graph. Configure these on the backend only.
CLINICAL_KG_NEO4J_URI=neo4j+s://63525938.databases.neo4j.io
CLINICAL_KG_NEO4J_USER=neo4j
CLINICAL_KG_NEO4J_PASSWORD=replace-with-your-aura-password
CLINICAL_KG_NEO4J_DATABASE=neo4j

# API security / frontend origin. Match your deployed frontend origin.
ALLOWED_ORIGINS=http://localhost:5173,https://your-vercel-domain.vercel.app
